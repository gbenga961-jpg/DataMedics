# Application Environment Configuration Template
# Copy this file to .env.local for local development. Never commit real secrets.

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session Security
SESSION_SECRET=
AUTH_SECRET=

# Database (PostgreSQL / Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Queue & Cache (Redis / BullMQ)
# Format: redis://[:PASSWORD@]HOST:PORT[/DB_NUMBER]
REDIS_URL=

# Private Object Storage
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_USE_SSL=true

# Operational & Safety Limits (PRD §7.1 and DECISIONS.md)
MAX_UPLOAD_SIZE_BYTES=10485760
TEMP_MAX_COLUMNS=100
TEMP_MAX_FIELD_SIZE_BYTES=32768
