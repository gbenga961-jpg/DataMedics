// Prisma Schema for DataMedics (PRD §15)
// Compliant with PRD v1.5 Final and Database Door in AGENTS.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UploadStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  DELETED
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum IssueType {
  MISSING_VALUES
  EXACT_DUPLICATE_ROWS
  INCONSISTENT_FORMATS
  UNNECESSARY_WHITESPACE
}

enum DetectionStatus {
  DETECTED
  NONE_DETECTED
  NOT_ASSESSED
}

enum CleaningOperation {
  TRIM_WHITESPACE
  REMOVE_BLANK_ROWS
  REMOVE_DUPLICATE_ROWS
}

enum DeletionStatus {
  NOT_SCHEDULED
  PENDING
  COMPLETED
  FAILED
}

model User {
  id           String         @id @default(uuid())
  name         String?
  email        String         @unique
  passwordHash String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  uploads      UploadedFile[]
  cleaningRuns CleaningRun[]
}

model UploadedFile {
  id                  String           @id @default(uuid())
  userId              String
  filename            String
  storageKey          String
  fileSizeBytes       Int
  mimeType            String
  rowCount            Int?
  columnCount         Int?
  uploadStatus        UploadStatus     @default(PENDING)
  uploadedAt          DateTime         @default(now())
  expiresAt           DateTime?
  deletionRequestedAt DateTime?
  deletionStatus      DeletionStatus   @default(NOT_SCHEDULED)
  fileDeletedAt       DateTime?
  deletedAt           DateTime?
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports             AnalysisReport[]

  @@index([userId])
  @@index([expiresAt])
}

model AnalysisReport {
  id             String             @id @default(uuid())
  uploadedFileId String
  status         JobStatus          @default(QUEUED)
  analysisDate   DateTime           @default(now())
  completedAt    DateTime?
  totalIssues    Int                @default(0)
  totalRows      Int                @default(0)
  totalColumns   Int                @default(0)
  ruleVersion    String             @default("1.0.0")
  failureCode    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  uploadedFile   UploadedFile       @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)
  issues         DataQualityIssue[]
  processingJob  ProcessingJob?
  cleaningRuns   CleaningRun[]

  @@index([uploadedFileId])
}

model DataQualityIssue {
  id                      String          @id @default(uuid())
  reportId                String
  issueType               IssueType
  affectedColumn          String
  issueCount              Int             @default(0)
  title                   String
  description             String
  recommendation          String
  detectionStatus         DetectionStatus @default(NOT_ASSESSED)
  detectedPattern         String?
  matchingValueCount      Int             @default(0)
  nonMatchingValueCount   Int             @default(0)
  unclassifiedValueCount  Int             @default(0)
  totalNonEmptyValueCount Int             @default(0)
  matchPercentage         Float?
  recognisedPatterns      Json?
  details                 Json?
  createdAt               DateTime        @default(now())
  report                  AnalysisReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model ProcessingJob {
  id              String         @id @default(uuid())
  reportId        String         @unique
  queueJobId      String?        @unique
  status          JobStatus      @default(QUEUED)
  attempts        Int            @default(0)
  maxAttempts     Int            @default(3)
  startedAt       DateTime?
  finishedAt      DateTime?
  lastHeartbeatAt DateTime?
  leaseExpiresAt  DateTime?
  lastErrorCode   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  report          AnalysisReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model CleaningRun {
  id                        String                @id @default(uuid())
  userId                    String
  reportId                  String
  queueJobId                String?               @unique
  idempotencyKey            String?
  requestFingerprint        String
  status                    JobStatus             @default(QUEUED)
  selectedOperations        CleaningOperation[]
  attempts                  Int                   @default(0)
  maxAttempts               Int                   @default(3)
  originalRowCount          Int
  finalRowCount             Int?
  whitespaceCellsTrimmed    Int                   @default(0)
  blankRowsRemoved          Int                   @default(0)
  duplicateRowsRemoved      Int                   @default(0)
  exportProtectedValueCount Int                   @default(0)
  startedAt                 DateTime?
  finishedAt                DateTime?
  lastHeartbeatAt           DateTime?
  leaseExpiresAt            DateTime?
  lastErrorCode             String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  user                      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  report                    AnalysisReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  cleanedFile               CleanedFile?
  cleaningResultIssues      CleaningResultIssue[]

  @@unique([userId, idempotencyKey])
  @@index([reportId])
}

model CleanedFile {
  id                       String         @id @default(uuid())
  cleaningRunId            String         @unique
  filename                 String
  canonicalStorageKey      String
  safeExportStorageKey     String
  fileSizeBytes            Int
  rowCount                 Int
  columnCount              Int
  exportProtectedValueCount Int            @default(0)
  createdAt                DateTime       @default(now())
  expiresAt                DateTime?
  deletionRequestedAt      DateTime?
  deletionStatus           DeletionStatus @default(NOT_SCHEDULED)
  canonicalFileDeletedAt   DateTime?
  safeExportFileDeletedAt  DateTime?
  fileDeletedAt            DateTime?
  cleaningRun              CleaningRun    @relation(fields: [cleaningRunId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model CleaningResultIssue {
  id              String          @id @default(uuid())
  cleaningRunId   String
  issueType       IssueType
  affectedColumn  String
  issueCount      Int             @default(0)
  recommendation  String
  detectionStatus DetectionStatus @default(NOT_ASSESSED)
  detectedPattern String?
  details         Json?
  createdAt       DateTime        @default(now())
  cleaningRun     CleaningRun     @relation(fields: [cleaningRunId], references: [id], onDelete: Cascade)

  @@index([cleaningRunId])
}
